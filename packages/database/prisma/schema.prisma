generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
  SUPPORT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

model User {
  id           String       @id @default(cuid())
  email        String?      @unique
  phone        String?      @unique
  passwordHash String?
  displayName  String?
  storeName    String?
  role         UserRole     @default(CUSTOMER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  addresses    Address[]
  carts        Cart[]
  orders       Order[]
  wishlists    Wishlist[]
  reviews      Review[]
  botSessions  BotSession[]
  vendor       Vendor?
}

model Vendor {
  id                String    @id @default(cuid())
  userId            String?   @unique
  name              String
  slug              String    @unique
  active            Boolean   @default(false)
  kycStatus         KycStatus @default(NOT_SUBMITTED)
  idType            String?
  idNumber          String?
  documentUrl       String?
  businessAddress   String?
  bankAccountName   String?
  bankAccountNumber String?
  bankName          String?
  kycSubmittedAt    DateTime?
  kycApprovedAt     DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User?     @relation(fields: [userId], references: [id])
  offers            Offer[]
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  description   String?
  status        ProductStatus   @default(DRAFT)
  categoryId    String
  brandId       String?
  attributes    Json            @default("{}")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  category      Category        @relation(fields: [categoryId], references: [id])
  brand         Brand?          @relation(fields: [brandId], references: [id])
  variants      ProductVariant[]
  reviews       Review[]
  wishlistItems WishlistItem[]
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  sku       String   @unique
  name      String
  attributes Json    @default("{}")
  images    String[]
  product   Product  @relation(fields: [productId], references: [id])
  offers    Offer[]
}

model Offer {
  id        String         @id @default(cuid())
  vendorId  String
  variantId String
  price     Decimal        @db.Decimal(12, 2)
  compareAt Decimal?       @db.Decimal(12, 2)
  currency  String         @default("NGN")
  active    Boolean        @default(true)
  vendor    Vendor         @relation(fields: [vendorId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  inventory Inventory?
  cartLines CartLine[]
  orderLines OrderLine[]
  @@unique([vendorId, variantId])
  @@index([variantId, active])
}

model Inventory {
  offerId   String   @id
  onHand    Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt
  offer     Offer    @relation(fields: [offerId], references: [id])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  channel   String     @default("WEB")
  expiresAt DateTime?
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id])
  lines     CartLine[]
}

model CartLine {
  id       String @id @default(cuid())
  cartId   String
  offerId  String
  quantity Int    @default(1)
  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  offer    Offer  @relation(fields: [offerId], references: [id])
  @@unique([cartId, offerId])
}

model StockReservation {
  id        String            @id @default(cuid())
  offerId   String
  cartId    String
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  @@index([offerId, status, expiresAt])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String?
  status      OrderStatus @default(PENDING_PAYMENT)
  payment     PaymentStatus @default(PENDING)
  currency    String      @default("NGN")
  subtotal    Decimal     @db.Decimal(12, 2)
  shippingFee Decimal     @db.Decimal(12, 2) @default(0)
  total       Decimal     @db.Decimal(12, 2)
  source      String
  addressId   String?
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id])
  lines       OrderLine[]
}

model OrderLine {
  id          String  @id @default(cuid())
  orderId     String
  offerId     String
  title       String
  sku         String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offer       Offer   @relation(fields: [offerId], references: [id])
}

model Address {
  id String @id @default(cuid())
  userId String
  label String?
  line1 String
  city String
  state String
  country String @default("NG")
  user User @relation(fields: [userId], references: [id])
}

model BotSession {
  id          String   @id @default(cuid())
  userId      String?
  waId        String   @unique
  state       Json     @default("{}")
  cartId      String?
  lastSeenAt  DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([wishlistId, productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int      @default(5)
  title     String?
  comment   String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

